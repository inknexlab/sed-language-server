{
  "name": "@inknexlab/sed-language-server",
  "version": "0.9.0",
  "description": "Language server for POSIX.1-2024 sed.",
  "type": "module",
  "files": [
    "bin",
    "src",
    "vendor"
  ],
  "exports": {
    "./analysis": "./src/analysis/index.js"
  },
  "bin": {
    "sed-language-server": "bin/sed-language-server.js"
  },
  "scripts": {
    "build:grammar": "node scripts/build-tree-sitter-posix-sed-wasm.js",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prepublishOnly": "npm run check && npm run verify:grammar && npm test",
    "start": "node bin/sed-language-server.js --stdio",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-timeout=20000 \"test/**/*.test.js\"",
    "verify:grammar": "node scripts/build-tree-sitter-posix-sed-wasm.js --verify"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inknexlab/sed-language-server.git"
  },
  "homepage": "https://github.com/inknexlab/sed-language-server#readme",
  "bugs": {
    "url": "https://github.com/inknexlab/sed-language-server/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "vscode-languageserver": "10.1.0",
    "vscode-languageserver-textdocument": "1.0.12",
    "web-tree-sitter": "0.26.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "tree-sitter-cli": "0.26.11"
  },
  "allowScripts": {
    "tree-sitter-cli@0.26.11": true
  }
}
